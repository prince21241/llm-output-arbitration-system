APP_ENV=development
DEBUG=true

SUPPORTED_THRESHOLD=0.75
INCORRECT_THRESHOLD=0.35

# Force the Phase 1 mocks even if provider keys are set.
USE_MOCK_JUDGES=false
JUDGE_TIMEOUT_SECONDS=20
JUDGE_MAX_TOKENS=256

# Leave a key empty to skip that provider. If all three are empty, mocks are used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Phase 3 Wikipedia lookup. Tests force this off.
ENABLE_EVIDENCE=true
WIKIPEDIA_LANGUAGE=en

# Phase 6 ML scorer. Falls back to the rule formula if no artifact is present.
USE_ML_SCORER=true

XAI_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=

# Clerk session auth. Empty secret keeps evaluate public for tests and key-less local runs.
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:5173,http://localhost:5173
